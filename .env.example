# Site
# Set this to the real production domain before deploying — it drives
# canonical URLs, hreflang tags, the sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public — safe to expose, RLS restricts what the anon key can do)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — used by the admin panel to bypass RLS. Never
# prefix with NEXT_PUBLIC_, never commit, never log.)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram booking notifications (server-only). Create a bot via @BotFather,
# then message the bot and call https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat id. Booking still works if these are unset — the
# notification is skipped, never blocking.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin panel password (server-only)
ADMIN_PASSWORD=
